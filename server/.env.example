# Copy this file to .env and adjust.
API_PORT=4000

# Any long random string. Change it before deploying anywhere.
JWT_SECRET=change-me-to-a-long-random-string

# Google sign-in: paste the OAuth "Web application" Client ID here to switch it on.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Comma-separated Google account emails that should get the admin role on sign-in.
ADMIN_EMAILS=

# true = show the demo login (pick a seeded user) and the "add demo drivers here" button.
# Set to false before going live.
DEMO_MODE=true
